# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# Portal target
PORTAL_BASE_URL=https://dib2.uat.smbp-v2.aladdinweb.dev
PORTAL_LOGIN_PATH=/index.html#/authenticate/login

# Credentials (required)
PORTAL_USERNAME=admin@appro.ae
PORTAL_PASSWORD=

# Optional: a URL fragment that confirms a successful login, e.g. #/dashboard
PORTAL_LOGGEDIN_HINT=

# Behaviour
HEADLESS=true        # set to false to watch the browser
SLOWMO=0             # ms delay between actions when watching
TIMEOUT_MS=45000
NAV_TIMEOUT_MS=45000
